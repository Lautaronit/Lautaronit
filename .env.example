# === On It — variables de entorno de ejemplo ===
# Copiá este archivo a ".env" dentro de apps/backend/ y completá los valores.
# NUNCA subas el archivo .env real al repositorio.

# Puerto donde corre el backend
PORT=3000

# Base de datos. Para desarrollo usamos SQLite (no requiere instalar nada).
# En producción se cambia por una URL de PostgreSQL, por ejemplo:
#   postgresql://usuario:password@localhost:5432/onit
DATABASE_URL="file:./dev.db"

# Clave de la API de Claude (Anthropic) — el cerebro que entiende los pedidos.
# Obtenela en https://console.anthropic.com/
# Si la dejás vacía, el agente funciona en "modo reglas" (sin IA real) para poder probar.
ANTHROPIC_API_KEY=

# Secreto para firmar los tokens JWT. En producción usá un valor largo y aleatorio
# (por ejemplo: openssl rand -hex 32). NUNCA uses el valor por defecto en producción.
JWT_SECRET=dev-secret-cambiar-en-produccion
