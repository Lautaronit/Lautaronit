# === On It — variables de entorno del backend ===
# Copiá este archivo a ".env" y completá los valores. NUNCA commitees el .env real.

# Puerto del servidor (en la nube suele venir dado por el host).
PORT=3000

# Base de datos.
#  - Local (desarrollo): SQLite en archivo.
#      DATABASE_URL="file:./dev.db"
#  - Producción: PostgreSQL (el host te da esta URL).
#      DATABASE_URL="postgresql://usuario:pass@host:5432/basedatos"
#    (recordá cambiar en prisma/schema.prisma: provider = "postgresql")
DATABASE_URL="file:./dev.db"

# Secreto para firmar los tokens JWT. EN PRODUCCIÓN: uno largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# CORS: dominios permitidos separados por coma. Vacío = permitir todos (dev).
# En producción: el dominio de tu app, ej. https://on-it.vercel.app
CORS_ORIGIN=

# --- Integraciones opcionales (sin clave, quedan inactivas) ---

# Agente con IA (Claude). Sin clave, el agente corre en modo reglas.
ANTHROPIC_API_KEY=
# Modelo del agente (barato y suficiente: claude-haiku-5-5).
AGENT_MODEL=claude-haiku-5-5

# Instacart Developer Platform. Sin clave, la integración queda inactiva.
INSTACART_API_KEY=
INSTACART_API_URL=https://connect.instacart.com
